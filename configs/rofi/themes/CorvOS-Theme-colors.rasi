/*
 * CorvOS-Theme palette.
 * Gruvbox-inspired dark colors, configured for CorvOS Desktop.
 */

* {
    background:     #282828;
    background-alt: #3c3836;
    foreground:     #ebdbb2;
    border:         #a89984;
    selected:       #83a598;
    active:         #b8bb26;
    urgent:         #fb4934;

    main-bg:        @background;
    main-fg:        @foreground;
    main-br:        @border;
    select-bg:      @selected;
    select-fg:      @background;
}
