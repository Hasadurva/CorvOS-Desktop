/*
 * CorvOS-Theme color definitions
 * Customized for CorvOS by Hasadurva, 2026.
 *
 * Based on the Gruvbox Rofi configuration in:
 * https://github.com/LilAiluropoda/hyprland-gruvbox-theme
 * Related Rofi styling template by Aditya Shakya (adi1090x):
 * https://github.com/adi1090x/rofi
 *
 * SPDX-License-Identifier: GPL-3.0-only
 */

* {
    /* Gruvbox dark colors */
    background:     #282828;
    background-alt: #3c3836;
    foreground:     #ebdbb2;
    border:         #a89984;
    selected:       #83a598;
    active:         #b8bb26;
    urgent:         #fb4934;

    /* Main theme colors */
    main-bg:        @background;
    main-fg:        @foreground;
    main-br:        @border;
    select-bg:      @selected;
    select-fg:      @background;
}
