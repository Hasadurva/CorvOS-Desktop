#!/bin/sh
STATE="${XDG_CACHE_HOME:-$HOME/.cache}/polybar-date-full"

if [ "$1" = "toggle" ]; then
    if [ -e "$STATE" ]; then
        rm "$STATE"
    else
        mkdir -p "$(dirname "$STATE")"
        : > "$STATE"
    fi
    /usr/bin/polybar-msg action date hook 0
    exit 0
fi

if [ -e "$STATE" ]; then
    LC_TIME=en_GB.UTF-8 /usr/bin/date "+%A, %-d. %B %Y"
else
    LC_TIME=en_GB.UTF-8 /usr/bin/date "+%-d. %b"
fi
