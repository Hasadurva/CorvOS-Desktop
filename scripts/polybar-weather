#!/usr/bin/env python3

import json
import sys
import urllib.parse
import urllib.request
from datetime import datetime

LAT = 52.5511
LON = 13.19921
TIMEZONE = "Europe/Berlin"

API = "https://api.open-meteo.com/v1/forecast"

GLYPHS = {
    "day-clear": "\ue000",
    "night-clear": "\ue001",
    "day-cloudy": "\ue002",
    "night-cloudy": "\ue003",
    "day-fog": "\ue004",
    "night-fog": "\ue005",
    "day-showers": "\ue006",
    "night-showers": "\ue007",
    "day-rain": "\ue008",
    "night-rain": "\ue009",
    "day-snow": "\ue00a",
    "night-snow": "\ue00b",
    "day-thunder": "\ue00c",
    "night-thunder": "\ue00d",
}

DESCRIPTIONS = {
    0: "Clear sky",
    1: "Mainly clear",
    2: "Partly cloudy",
    3: "Overcast",
    45: "Fog",
    48: "Depositing rime fog",
    51: "Light drizzle",
    53: "Moderate drizzle",
    55: "Dense drizzle",
    56: "Light freezing drizzle",
    57: "Dense freezing drizzle",
    61: "Slight rain",
    63: "Moderate rain",
    65: "Heavy rain",
    66: "Light freezing rain",
    67: "Heavy freezing rain",
    71: "Slight snow",
    73: "Moderate snow",
    75: "Heavy snow",
    77: "Snow grains",
    80: "Slight rain showers",
    81: "Moderate rain showers",
    82: "Violent rain showers",
    85: "Slight snow showers",
    86: "Heavy snow showers",
    95: "Thunderstorm",
    96: "Thunderstorm with slight hail",
    99: "Thunderstorm with heavy hail",
}


def fetch_weather():
    params = urllib.parse.urlencode({
        "latitude": LAT,
        "longitude": LON,
        "current": (
            "temperature_2m,relative_humidity_2m,apparent_temperature,"
            "precipitation,weather_code,wind_speed_10m,wind_direction_10m,is_day"
        ),
        "daily": (
            "weather_code,temperature_2m_max,temperature_2m_min,"
            "precipitation_probability_max,sunrise,sunset"
        ),
        "forecast_days": 7,
        "timezone": TIMEZONE,
    })

    with urllib.request.urlopen(f"{API}?{params}", timeout=10) as response:
        return json.load(response)


def icon_for(code, is_day):
    night = not bool(is_day)

    if code == 0:
        return GLYPHS["night-clear" if night else "day-clear"]

    if code in (1, 2, 3):
        return GLYPHS["night-cloudy" if night else "day-cloudy"]

    if code in (45, 48):
        return GLYPHS["night-fog" if night else "day-fog"]

    if code in (51, 53, 55, 56, 57):
        return GLYPHS["night-rain" if night else "day-showers"]

    if code in (61, 63, 65, 66, 67):
        return GLYPHS["night-rain" if night else "day-rain"]

    if code in (71, 73, 75, 77, 85, 86):
        return GLYPHS["night-snow" if night else "day-snow"]

    if code in (80, 81, 82):
        return GLYPHS["night-showers" if night else "day-showers"]

    if code in (95, 96, 99):
        return GLYPHS["night-thunder" if night else "day-thunder"]

    return GLYPHS["night-cloudy" if night else "day-cloudy"]


def output_icon():
    try:
        data = fetch_weather()
        current = data["current"]
        code = int(current["weather_code"])
        is_day = int(current["is_day"])
        print(icon_for(code, is_day))
    except Exception:
        # Keep the module visible with a sensible fallback.
        print(GLYPHS["day-cloudy"])


def output_forecast():
    try:
        data = fetch_weather()
    except Exception as exc:
        print(f"Weather unavailable: {exc}")
        input("\nPress Enter to close...")
        return

    current = data["current"]
    daily = data["daily"]

    current_code = int(current["weather_code"])

    print("╭────────────────────────────────────╮")
    print("│           WEATHER · SPANDAU        │")
    print("╰────────────────────────────────────╯")
    print()
    print(
        f"Current:       {current['temperature_2m']:.1f}°C"
        f"  (feels {current['apparent_temperature']:.1f}°C)"
    )
    print(
        f"Condition:     {DESCRIPTIONS.get(current_code, 'Unknown')}"
    )
    print(
        f"Humidity:      {current['relative_humidity_2m']}%"
    )
    print(
        f"Precipitation: {current['precipitation']:.1f} mm"
    )
    print(
        f"Wind:          {current['wind_speed_10m']:.0f} km/h"
        f"  {current['wind_direction_10m']}°"
    )

    print()
    print("7-DAY FORECAST")
    print("────────────────────────────────────")

    for i, date_text in enumerate(daily["time"]):
        date_obj = datetime.fromisoformat(date_text)
        day = date_obj.strftime("%a %d %b")

        code = int(daily["weather_code"][i])
        high = daily["temperature_2m_max"][i]
        low = daily["temperature_2m_min"][i]
        rain = daily["precipitation_probability_max"][i]

        desc = DESCRIPTIONS.get(code, "Unknown")

        print(
            f"{day:<11} "
            f"{high:>4.1f}°/{low:>4.1f}°  "
            f"{rain:>3}%  {desc}"
        )

    print()
    print(
        f"Sunrise: {daily['sunrise'][0].replace('T', ' ')}"
    )
    print(
        f"Sunset:  {daily['sunset'][0].replace('T', ' ')}"
    )

    print()
    input("Press Enter to close...")


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "icon"

    if mode == "icon":
        output_icon()
    elif mode == "full":
        output_forecast()
    else:
        print(f"Unknown mode: {mode}", file=sys.stderr)
        raise SystemExit(1)


if __name__ == "__main__":
    main()
