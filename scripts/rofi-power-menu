#!/usr/bin/env bash

shutdown="Shutdown"
reboot="Reboot"
lock="Lock Screen"
suspend="Suspend"
logout="Logout"

chosen=$(printf '%s\n' \
    "$lock" \
    "$suspend" \
    "$logout" \
    "$reboot" \
    "$shutdown" |
    rofi -dmenu -i -no-custom -p "System")

case "$chosen" in
    *"Shutdown"*)
        systemctl poweroff
        ;;
    *"Reboot"*)
        systemctl reboot
        ;;
    *"Lock Screen"*)
        cinnamon-screensaver-command --lock
        ;;
    *"Suspend"*)
        systemctl suspend
        ;;
    *"Logout"*)
        i3-msg exit
        ;;
esac
