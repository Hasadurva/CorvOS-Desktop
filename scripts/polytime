#!/usr/bin/env python3
import json
import math
import os
import signal
import shutil
import subprocess
import time
from datetime import datetime
from threading import Event

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.join(os.path.expanduser("~"), ".cache")),
    "corvos",
    "run",
)
STATE = os.path.join(RUNTIME, "polytime.state")
wake = Event()
running = True

def set_name(name="polytime"):
    try:
        with open("/proc/self/comm", "w", encoding="utf-8") as f:
            f.write(name[:15])
    except OSError:
        pass

def wake_up(sig, frame):
    wake.set()

def stop(sig, frame):
    global running
    running = False
    wake.set()

signal.signal(signal.SIGUSR1, wake_up)
signal.signal(signal.SIGTERM, stop)
signal.signal(signal.SIGINT, stop)

def clock():
    return datetime.now().strftime("%H:%M")

def format_remaining(seconds):
    secs = max(0, int(math.ceil(seconds)))
    hours, rem = divmod(secs, 3600)
    minutes, secs = divmod(rem, 60)
    if hours > 0:
        return f"{hours:02d}:{minutes:02d}:{secs:02d}"
    return f"{minutes:02d}:{secs:02d}"

def load_state():
    try:
        with open(STATE, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError, TypeError, KeyError):
        return None

def clear_state():
    try:
        os.unlink(STATE)
    except FileNotFoundError:
        pass
    except OSError:
        pass

def save_state(end_time, label):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    temp = STATE + ".tmp"
    with open(temp, "w", encoding="utf-8") as f:
        json.dump({"end": end_time, "label": label}, f)
    os.replace(temp, STATE)

def notify_complete(label):
    notify = shutil.which("notify-send")
    if notify:
        subprocess.run([notify, "-u", "critical", "Timer Complete", label], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    paplay = shutil.which("paplay")
    if paplay:
        subprocess.run([paplay, "/usr/share/sounds/freedesktop/stereo/complete.oga"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        print("\a", end="", flush=True)

def signal_daemon():
    try:
        result = subprocess.run(["/usr/bin/pgrep", "-u", str(os.getuid()), "-x", "polytime"], capture_output=True, text=True)
        for line in result.stdout.splitlines():
            try:
                os.kill(int(line.strip()), signal.SIGUSR1)
            except (ValueError, ProcessLookupError, PermissionError):
                pass
    except OSError:
        pass

def parse_duration(value):
    value = value.strip().lower()
    if not value:
        return None
    suffix = value[-1]
    try:
        if suffix in "smh":
            number = float(value[:-1])
        else:
            number = float(value)
    except ValueError:
        return None
    if number <= 0:
        return None
    if suffix == "s":
        return number
    if suffix == "h":
        return number * 3600
    return number * 60

def run_toggle():
    set_name("polytime-toggle")
    state = load_state()
    if state is not None and state.get("end", 0) > time.time():
        clear_state()
        signal_daemon()
        return

    rofi = shutil.which("rofi")
    if not rofi:
        return
    result = subprocess.run([rofi, "-dmenu", "-p", "Timer"], capture_output=True, text=True)
    raw = result.stdout.strip()
    if not raw:
        return

    parts = raw.split(maxsplit=1)
    seconds = parse_duration(parts[0])
    if seconds is None:
        notify = shutil.which("notify-send")
        if notify:
            subprocess.run([notify, "Timer", "Use 30s, 15m, 1h, etc."], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return

    label = parts[1].strip() if len(parts) > 1 else "Timer Finished!"
    save_state(time.time() + seconds, label)
    signal_daemon()

def run_daemon():
    set_name()
    while running:
        state = load_state()
        now = time.time()

        if state is not None:
            remaining = state.get("end", 0) - now
            if remaining <= 0:
                label = state.get("label", "Timer Finished!")
                clear_state()
                notify_complete(label)
                print(clock(), flush=True)
                timeout = max(0.1, 60 - (time.time() % 60))
            else:
                print(f"{clock()} — " + "%{F#83A598}" + format_remaining(remaining) + "%{F-}", flush=True)
                timeout = max(0.05, 1 - (time.time() % 1))
        else:
            print(clock(), flush=True)
            timeout = max(0.1, 60 - (time.time() % 60))

        wake.wait(timeout)
        wake.clear()

if __name__ == "__main__":
    if len(os.sys.argv) > 1 and os.sys.argv[1] == "toggle":
        run_toggle()
    else:
        run_daemon()
